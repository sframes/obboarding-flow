# LLM Provider — currently supports "openai" (works with OpenRouter via LLM_BASE_URL)
LLM_PROVIDER=openai

# Model name (for OpenRouter, use provider/model format)
LLM_MODEL=deepseek/deepseek-chat

# API key
LLM_API_KEY=your-api-key-here

# Base URL — for OpenRouter: https://openrouter.ai/api/v1
# For OpenAI directly: https://api.openai.com/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
